# Joyce eval harness configuration.
#
# Copy to the repo root as `.env` and edit:
#     cp evals/env.example .env
#
# Every value here is optional — evals/config.js has working defaults for all of them.
# Precedence: code defaults -> .env -> environment -> CLI flags.
#
# Loaded via Node 24's built-in process.loadEnvFile(), so there is no dotenv dependency.
# `.gitignore` already ignores `.env`, so your local copy will not be committed.

# ---------------------------------------------------------------------------
# App under test
# ---------------------------------------------------------------------------
# The harness probes this URL first. If Joyce is already being served there (e.g. you have
# `npm run dev` running) it reuses it and never touches it. Otherwise it spawns its own
# `npx serve` and tears that down on exit.
JOYCE_EVAL_APP_URL=http://127.0.0.1:4300/
JOYCE_EVAL_AUTOSTART_SERVER=true
JOYCE_EVAL_PORT=4300

# ---------------------------------------------------------------------------
# Chrome
# ---------------------------------------------------------------------------
# Leave blank to auto-discover Google Chrome. A dedicated persistent profile is used so
# web-llm's multi-GB model downloads survive between runs.
JOYCE_EVAL_CHROME_BINARY=
JOYCE_EVAL_CHROME_PROFILE=.data/evals/chrome-profile

# Headful is the default and is strongly recommended: headless Chrome on macOS may not get a
# Metal-backed WebGPU adapter, and falling back to SwiftShader (CPU) makes a 4B model unusably
# slow and its latency numbers meaningless. Headless runs are marked non-comparable and cannot
# write a baseline.
JOYCE_EVAL_HEADLESS=false

# ---------------------------------------------------------------------------
# System under test
# ---------------------------------------------------------------------------
JOYCE_EVAL_DRIVER=pipeline

# Comma-separated "provider::modelId". Providers come from the app's own registry, so any
# provider added to public/config.js (LiteRT.js, wllama, ...) works with no harness change.
JOYCE_EVAL_MODELS=webLlm::Llama-3.2-1B-Instruct-q4f16_1-MLC,webLlm::Qwen3.5-2B-q4f16_1-MLC

# 0 for gating runs. The app's own default is 0.4 — use that with JOYCE_EVAL_SAMPLES=3 when you
# want production-fidelity numbers rather than a deterministic gate.
JOYCE_EVAL_TEMPERATURE=0
JOYCE_EVAL_SAMPLES=1

# ---------------------------------------------------------------------------
# Judge
# ---------------------------------------------------------------------------
# off | local | anthropic | openai
# `local` targets any OpenAI-compatible server (llama.cpp's llama-server, vLLM).
JOYCE_EVAL_JUDGE=local
JOYCE_EVAL_JUDGE_BASE_URL=http://127.0.0.1:8001/v1

# "auto" discovers the id from GET /v1/models — llama-server reports its --alias, which changes
# when you switch launchers (qwen3.6-35b-a3b-mtp, gemma-4-26b-a4b-qat, glm-4.7-flash, ...).
# Auto-discovery means the harness keeps working across those switches, and the resolved id is
# recorded in every result and baseline so a judge swap is visible rather than silent.
JOYCE_EVAL_JUDGE_MODEL=auto

# Cloud judges for CI. Only the one matching JOYCE_EVAL_JUDGE is read.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# Under .data/ so generated artifacts are ignored by git, eslint, and prettier. Committed
# baselines live in evals/baselines/ instead, so score changes show up in PRs.
JOYCE_EVAL_OUT_DIR=.data/evals
JOYCE_EVAL_LOG_LEVEL=info
