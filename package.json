{
  "name": "joyce",
  "version": "0.0.1",
  "description": "A small, browser-based knowledge assistant for Nearform's web content.",
  "type": "module",
  "license": "SEE LICENSES IN LICENSE.txt AND public/data/LICENSE.txt",
  "scripts": {
    "dev": "npx serve -p 4300",
    "dev:root": "npx serve -c serve-root.json -p 4301",
    "data:embeddings": "node ./scripts/embeddings.js",
    "evals": "node ./evals/run.js",
    "evals:holdout": "node ./evals/run.js --include-holdout",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --quiet",
    "pretty:fix": "prettier . --write",
    "pretty:check": "prettier . --check",
    "check": "npm run lint:check && npm run pretty:check",
    "format": "npm run lint:fix && npm run pretty:fix",
    "dep:check": "npx npm-check-updates"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@xenova/transformers": "^2.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "llm-splitter": "^0.2.0",
    "prettier": "^3.9.6"
  }
}
